#Enable JourneyMap terrain sharing.
enabled = true
#Max shared map chunks applied to JourneyMap per client tick.
#Lower values reduce hitching; the rest stay buffered.
# Default: 2
# Range: 1 ~ 16
maxAppliesPerTick = 1
#Max incoming map chunks buffered on the client.
#If exceeded, farthest chunks from the player are dropped.
# Default: 16384
# Range: 256 ~ 65536
maxPendingApplies = 16384
